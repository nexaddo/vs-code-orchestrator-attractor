{
  "name": "@attractor/extension",
  "version": "0.0.0",
  "private": true,
  "displayName": "Attractor",
  "description": "Graph-driven multi-step coding workflows orchestrated via the Copilot SDK",
  "publisher": "attractor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_ORG/vs-code-orchestrator-attractor"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "copilot",
    "orchestration",
    "graph",
    "workflow",
    "ai"
  ],
  "engines": {
    "vscode": "^1.103.0"
  },
  "main": "dist/bundle.js",
  "activationEvents": [
    "onCommand:attractor.hello",
    "onCommand:attractor.run.start",
    "onCommand:attractor.run.cancel",
    "onCommand:attractor.plan.create",
    "onChatParticipant:attractor.attractor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "attractor.hello",
        "title": "Attractor: Hello"
      },
      {
        "command": "attractor.run.start",
        "title": "Attractor: Start Run"
      },
      {
        "command": "attractor.run.cancel",
        "title": "Attractor: Cancel Run"
      },
      {
        "command": "attractor.plan.create",
        "title": "Attractor: Create Plan"
      }
    ],
    "chatParticipants": [
      {
        "id": "attractor.attractor",
        "fullName": "Attractor",
        "name": "attractor",
        "description": "Graph-driven multi-step coding workflow orchestrator",
        "isSticky": true,
        "commands": [
          {
            "name": "plan",
            "description": "Create a new plan from a natural-language goal"
          },
          {
            "name": "run",
            "description": "Start an orchestration run on the active plan"
          },
          {
            "name": "status",
            "description": "Check current Attractor status"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node esbuild.config.mjs",
    "bundle:watch": "node esbuild.config.mjs --watch",
    "package": "pnpm run build && pnpm run bundle && vsce package --no-dependencies",
    "publish:marketplace": "pnpm run package && vsce publish --no-dependencies"
  },
  "dependencies": {
    "@attractor/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.5"
  }
}
