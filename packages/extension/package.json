{
  "name": "@attractor/extension",
  "version": "0.0.0",
  "private": true,
  "displayName": "Attractor",
  "engines": {
    "vscode": "^1.103.0"
  },
  "main": "dist/src/extension.js",
  "types": "dist/src/extension.d.ts",
  "activationEvents": [
    "onCommand:attractor.hello",
    "onView:attractor.dashboard",
    "onChatParticipant:attractor.attractor"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "attractor-explorer",
          "title": "Attractor",
          "icon": "resources/attractor-icon.svg"
        }
      ]
    },
    "views": {
      "attractor-explorer": [
        {
          "type": "webview",
          "id": "attractor.dashboard",
          "name": "Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "attractor.hello",
        "title": "Attractor: Hello"
      },
      {
        "command": "attractor.run.start",
        "title": "Attractor: Start Run"
      },
      {
        "command": "attractor.run.cancel",
        "title": "Attractor: Cancel Run"
      },
      {
        "command": "attractor.plan.create",
        "title": "Attractor: Create Plan"
      }
    ],
    "chatParticipants": [
      {
        "id": "attractor.attractor",
        "name": "attractor",
        "description": "AI orchestration assistant for Attractor plans",
        "isSticky": true,
        "commands": [
          {
            "name": "plan",
            "description": "Create an orchestration plan"
          },
          {
            "name": "run",
            "description": "Start an orchestration run"
          },
          {
            "name": "status",
            "description": "Show current orchestration status"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@attractor/shared": "workspace:*",
    "@ts-graphviz/parser": "^0.6.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@vscode/test-electron": "^2.5.2"
  }
}
