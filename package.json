{
  "name": "vs-code-orchestrator-attractor",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "ci:fast-checks": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "postinstall": "git config core.hooksPath .githooks",
    "pack": "pnpm --filter @attractor/extension run package",
    "release:dry": "pnpm run ci:fast-checks && pnpm run pack"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.1",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "lint-staged": "^15.2.11",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,json}": "prettier --write"
  }
}
